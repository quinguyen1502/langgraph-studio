# Copy to .env (never commit .env). Used by `docker compose up` and read by the backend in dev.

# --- secrets (required for docker compose) ---
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
# Fernet key for stored LLM credentials; empty = generated once into the api volume (/data/secret.key)
STUDIO_SECRET_KEY=

# --- database / redis ---
POSTGRES_USER=studio
POSTGRES_DB=studio
# Local dev without compose: leave DATABASE_URL empty for SQLite (backend/studio.db), or e.g.
# DATABASE_URL=postgresql://studio:change-me@localhost:5432/studio
# REDIS_URL empty = in-memory run bus (single process); e.g. REDIS_URL=redis://localhost:6379/0

# --- app ---
# production = refuse the placeholder JWT_SECRET (the demo user admin@example.com is still seeded)
STUDIO_ENV=dev
WEB_PORT=8080
STUDIO_RUN_TIMEOUT=120
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- tracing (TASK-0010); all empty = tracing off (no-op) ---
# OpenTelemetry OTLP/HTTP, standard OTEL_* variables. With `docker compose --profile tracing up`:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
#   STUDIO_TRACE_URL=http://localhost:16686/trace/{trace_id}
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=langgraph-studio
# Link template shown in the run timeline/history ({trace_id} is replaced)
STUDIO_TRACE_URL=
# LangSmith (optional): exported over its OTLP endpoint only when both are set
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# --- API triggers (TASK-0007) ---
# Run queued API jobs inside the API process (1, default) or only in `python -m app.worker` (0; needs REDIS_URL)
STUDIO_WORKER=1
STUDIO_WORKER_CONCURRENCY=2
# Allow result webhooks to private / loopback addresses (SSRF guard; keep 0 in production)
STUDIO_ALLOW_PRIVATE_CALLBACKS=0

# --- phase-2 hardening (TASK-0019) ---
# Human-in-the-loop: waiting runs expire after this many seconds (0 = never). Default 7 days.
STUDIO_WAIT_TTL=604800
# API triggers: runs per token per window (0 = off); sync mode waits at most this long, then 202 + poll_url.
STUDIO_TRIGGER_RATE_LIMIT=60
STUDIO_TRIGGER_RATE_WINDOW=60
STUDIO_SYNC_WAIT_MAX=30
# Workflow versions: keep the newest N (0 = keep all). Versions used by runs are never deleted.
STUDIO_VERSION_KEEP=0
# LLM price overrides, USD per 1M tokens {"model-prefix": [input, output]}. STUDIO_PRICES wins over the file.
STUDIO_PRICES=
STUDIO_PRICES_FILE=
