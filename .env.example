# Copy to .env (never commit .env). Used by `docker compose up` and read by the backend in dev.

# --- secrets (required for docker compose) ---
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
# Fernet key for stored LLM credentials; empty = generated once into the api volume (/data/secret.key)
STUDIO_SECRET_KEY=

# --- database / redis ---
POSTGRES_USER=studio
POSTGRES_DB=studio
# Local dev without compose: leave DATABASE_URL empty for SQLite (backend/studio.db), or e.g.
# DATABASE_URL=postgresql://studio:change-me@localhost:5432/studio
# REDIS_URL empty = in-memory run bus (single process); e.g. REDIS_URL=redis://localhost:6379/0

# --- app ---
# production = refuse the placeholder JWT_SECRET (the demo user admin@example.com is still seeded)
STUDIO_ENV=dev
WEB_PORT=8080
STUDIO_RUN_TIMEOUT=120
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- tracing (TASK-0010); all empty = tracing off (no-op) ---
# OpenTelemetry OTLP/HTTP, standard OTEL_* variables. With `docker compose --profile tracing up`:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
#   STUDIO_TRACE_URL=http://localhost:16686/trace/{trace_id}
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=langgraph-studio
# Link template shown in the run timeline/history ({trace_id} is replaced)
STUDIO_TRACE_URL=
# LangSmith (optional): exported over its OTLP endpoint only when both are set
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# --- API triggers (TASK-0007) ---
# Run queued API jobs inside the API process (1, default) or only in `python -m app.worker` (0; needs REDIS_URL)
STUDIO_WORKER=1
STUDIO_WORKER_CONCURRENCY=2
# Allow result webhooks to private / loopback addresses (SSRF guard; keep 0 in production)
STUDIO_ALLOW_PRIVATE_CALLBACKS=0

# --- phase-2 hardening (TASK-0019) ---
# Human-in-the-loop: waiting runs expire after this many seconds (0 = never). Default 7 days.
STUDIO_WAIT_TTL=604800
# API triggers: runs per token per window (0 = off); sync mode waits at most this long, then 202 + poll_url.
STUDIO_TRIGGER_RATE_LIMIT=60
STUDIO_TRIGGER_RATE_WINDOW=60
STUDIO_SYNC_WAIT_MAX=30
# Workflow versions: keep the newest N (0 = keep all). Versions used by runs are never deleted.
STUDIO_VERSION_KEEP=0
# LLM price overrides, USD per 1M tokens {"model-prefix": [input, output]}. STUDIO_PRICES wins over the file.
STUDIO_PRICES=
STUDIO_PRICES_FILE=

# --- deferred hardening (TASK-0020) ---
# Public base URL used for links in notification e-mails / webhooks (e.g. https://studio.example.com)
STUDIO_PUBLIC_URL=
# E-mail notification when a run waits for a human. Unset SMTP_HOST = no e-mail (in-app bell only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=studio@localhost
SMTP_STARTTLS=1
SMTP_SSL=0
# Optional generic notify webhook (JSON POST per waiting/expired run), HMAC-signed when the secret is set.
STUDIO_NOTIFY_WEBHOOK_URL=
STUDIO_NOTIFY_WEBHOOK_SECRET=
# Result-webhook deliveries: attempts, exponential backoff base/max (seconds).
STUDIO_WEBHOOK_MAX_ATTEMPTS=5
STUDIO_WEBHOOK_BACKOFF_BASE=2
STUDIO_WEBHOOK_BACKOFF_MAX=300
# After rotating a signing secret the previous one stays valid this many seconds.
STUDIO_SECRET_GRACE=86400
# Redis queue: job lease (visibility timeout) and stale-job reaper interval, seconds.
STUDIO_JOB_VISIBILITY_TIMEOUT=30
STUDIO_JOB_REAP_EVERY=15
# Export OTel metrics (runs, duration, tokens, cost, errors) over OTLP; needs OTEL_EXPORTER_OTLP_ENDPOINT.
STUDIO_OTEL_METRICS=0

# --- effectively-once + live notifications (TASK-0021) ---
# No new settings: idempotency keys, the node ledger and fencing are always on; live push uses REDIS_URL when set.

# --- approval through Slack / Telegram (TASK-0022) ---
# Callbacks need the public https STUDIO_PUBLIC_URL above. Buttons expire after STUDIO_APPROVAL_TTL seconds.
STUDIO_APPROVAL_TTL=86400
# Comma-separated e-mails of admins who manage org-wide approval channels (applied at sign-up and at start-up).
STUDIO_ADMIN_EMAILS=
# Per-window (60 s) limits of the public callback endpoints: per client IP and per connection / Slack workspace.
STUDIO_CALLBACK_RATE_LIMIT_IP=60
STUDIO_CALLBACK_RATE_LIMIT_CHANNEL=300
